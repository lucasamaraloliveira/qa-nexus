generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Version {
  id            Int      @id @default(autoincrement())
  versionNumber String
  releaseDate   String?
  status        String?
  description   String?
  scripts       Script[]

  @@map("versions")
}

model Script {
  id         Int     @id @default(autoincrement())
  versionId  Int     @map("version_id")
  name       String?
  type       String?
  content    String?
  folder     String?
  version    Version @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("scripts")
}

model BuildDoc {
  id          Int     @id @default(autoincrement())
  title       String?
  system      String?
  content     String?
  lastUpdated String?

  @@map("build_docs")
}

model UsefulDoc {
  id          Int     @id @default(autoincrement())
  title       String?
  content     String?
  lastUpdated String?

  @@map("useful_docs")
}

model Manual {
  id           Int      @id @default(autoincrement())
  name         String?
  originalName String?
  path         String?
  type         String?
  size         Int?
  uploadDate   String?
  parentId     String?
  isFolder     Boolean  @default(false)

  @@map("manuals")
}

model TestPlan {
  id          Int        @id @default(autoincrement())
  name        String?
  description String?
  progress    Int?
  testCases   TestCase[]

  @@map("test_plans")
}

model TestCase {
  id             Int      @id @default(autoincrement())
  testPlanId     Int      @map("test_plan_id")
  title          String?
  preconditions  String?
  steps          String?
  expectedResult String?
  status         String?
  estimatedTime  String?
  priority       String?
  assignedTo     String?
  testPlan       TestPlan @relation(fields: [testPlanId], references: [id], onDelete: Cascade)

  @@map("test_cases")
}

model User {
  id             Int     @id @default(autoincrement())
  username       String? @unique
  password       String?
  profilePicture String?
  role           String? @default("Tester")

  @@map("users")
}

model ChangelogSystem {
  id          Int                @id @default(autoincrement())
  name        String
  description String?
  entries     ChangelogEntry[]

  @@map("changelog_systems")
}

model ChangelogEntry {
  id        Int               @id @default(autoincrement())
  systemId  Int               @map("system_id")
  version   String
  date      String?
  type      String? // 'major', 'minor', 'patch'
  system    ChangelogSystem   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  items     ChangelogItem[]

  @@map("changelog_entries")
}

model ChangelogItem {
  id          Int            @id @default(autoincrement())
  entryId     Int            @map("entry_id")
  title       String?
  description String?
  type        String? // 'feature', 'fix', 'improvement'
  category    String?
  image       String?
  entry       ChangelogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@map("changelog_items")
}

model AuditLog {
  id         Int     @id @default(autoincrement())
  userId     Int?
  username   String?
  action     String? // 'CREATE', 'UPDATE', 'DELETE', 'LOGIN', etc.
  module     String? // 'AUTH', 'VERSIONS', 'DOCS', etc.
  resourceId String?
  details    String?
  timestamp  String?
  ipAddress  String?

  @@map("audit_logs")
}

model SystemSetting {
  key   String @id
  value String?

  @@map("system_settings")
}

model Site {
  id          Int             @id @default(autoincrement())
  name        String?
  url         String
  status      String?         @default("PENDING")
  lastChecked String?         @map("last_checked")
  logs        MonitoringLog[]

  @@map("sites")
}

model MonitoringLog {
  id           Int      @id @default(autoincrement())
  siteId       Int      @map("site_id")
  status       Int?
  responseTime Int?     @map("response_time")
  timestamp    DateTime @default(now())
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("logs")
}
